# Copia in .env e riempi. .env è ignorato da git: non metterci mai segreti reali
# che non vuoi perdere, la fonte di verità resta Key Vault (settimana 12).

# --- Sempre ---
RAG_ENVIRONMENT=local
RAG_LOG_LEVEL=INFO

# --- Settimana 03: Key Vault ---
# RAG_KEY_VAULT_URI=https://<nome>.vault.azure.net/

# --- Settimana 08: Cosmos DB for NoSQL ---
# RAG_COSMOS_ENDPOINT=https://<nome>.documents.azure.com:443/
# RAG_COSMOS_DATABASE=rag
# RAG_COSMOS_CONTAINER=documenti

# --- Settimana 09: PostgreSQL con pgvector ---
# RAG_POSTGRES_HOST=<nome>.postgres.database.azure.com
# RAG_POSTGRES_DB=rag
# RAG_POSTGRES_USER=<utente>

# --- Settimana 10: Redis ---
# RAG_REDIS_HOST=<nome>.redis.azure.net
# RAG_REDIS_PORT=10000

# --- Settimana 11: Service Bus ed Event Grid ---
# RAG_SERVICEBUS_NAMESPACE=<nome>.servicebus.windows.net
# RAG_SERVICEBUS_QUEUE=ingest

# --- Settimana 12: App Configuration e tracing ---
# RAG_APPCONFIG_ENDPOINT=https://<nome>.azconfig.io
# APPLICATIONINSIGHTS_CONNECTION_STRING=
